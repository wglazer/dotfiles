# Shared shell environment for zsh and Bash.
# Aliases stay here for reuse but load only in interactive shells.

if [ "${DOTFILES_COMMON_LOADED:-0}" = 1 ]; then
    return 0 2>/dev/null || true
fi
export DOTFILES_COMMON_LOADED=1

# Homebrew works from either Apple Silicon or Intel locations.
if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

case "$-" in
    *i*)
        alias ls='eza'
        alias l='eza'
        alias ll='eza -lah --git'
        alias la='eza -a'
        alias lt='eza --tree --level=2'

        alias cat='bat'
        alias grep='rg'

        alias g='git'
        alias gs='git status'
        alias gd='git diff'
        alias gl='git log --oneline --graph --decorate'
        alias lg='lazygit'

        alias v='nvim'
        alias vim='nvim'
        alias zj='zellij'

        alias ..='cd ..'
        alias ...='cd ../..'
        alias ....='cd ../../..'

        case "${OSTYPE:-}" in
            darwin*)
                alias copy='pbcopy'
                alias paste='pbpaste'
                ;;
        esac
        ;;
esac
