#!/usr/bin/env bash
set -Eeuo pipefail

OP_ACCOUNT="${DOTFILES_OP_ACCOUNT:-osedea}"

command -v op >/dev/null 2>&1 || {
    printf '1Password CLI (op) is not installed.\n' >&2
    exit 1
}

if op whoami --account "$OP_ACCOUNT" >/dev/null 2>&1; then
    exit 0
fi

exec op signin --account "$OP_ACCOUNT"
