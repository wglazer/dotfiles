###################################
# Shell / navigation
###################################
# Improved shell history for zsh, bash, fish and nushell
brew "atuin"
# Load/unload environment variables based on $PWD
brew "direnv"
# Command-line fuzzy finder written in Go
brew "fzf"
# Cross-shell prompt for astronauts
brew "starship"
# Shell extension to navigate your filesystem faster
brew "zoxide"

###################################
# Core CLI
###################################
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Modern, maintained replacement for ls
brew "eza"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Internet file retriever
brew "wget"
# Practical command examples and simplified man pages
brew "tlrc"

###################################
# Git
###################################
# Distributed revision control system
brew "git"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# GitHub command-line tool
brew "gh"
# Use Commitizen to create Conventional Commits interactively
brew "commitizen"

###################################
# Development environments
###################################
# Extremely fast Python package and project manager, written in Rust
brew "uv"
# Handy way to save and run project-specific commands
brew "just"

###################################
# System / debugging
###################################
# Resource monitor. C++ version and continuation of bashtop and bpytop
brew "btop"
# More intuitive version of du in Rust
brew "dust"
# Command-line benchmarking tool
brew "hyperfine"
# Run arbitrary commands when files change
brew "entr"
# Executes a program periodically, showing output fullscreen
brew "watch"

###################################
# Editor / terminal workspace
###################################
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Pluggable terminal workspace, with terminal multiplexer as the base feature
brew "zellij"

###################################
# macOS applications
###################################
# Desktop app enables Touch ID integration for the CLI
cask "1password"
# Command-line interface for 1Password
cask "1password-cli"
# JetBrains Mono patched with Nerd Fonts glyphs
cask "font-jetbrains-mono-nerd-font"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Move and resize windows on macOS with keyboard shortcuts and snap areas
cask "rectangle"
# Prevent screen from shutting down
cask "caffeine"

###################################
# Containers
###################################
# Container runtimes on macOS and Linux with minimal setup
brew "colima"
# Pack, ship and run any application as a lightweight container
brew "docker"
# Define and run multi-container applications with Docker
brew "docker-compose"
# Docker CLI plugin for extended build capabilities with BuildKit
brew "docker-buildx"
